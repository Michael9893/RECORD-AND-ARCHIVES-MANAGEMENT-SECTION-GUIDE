rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Standard global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');
    }

    // Dynamic schemas
    match /categories/{categoryId} {
      allow read: if true; // Public division structure access
      allow write: if true; // Write authorization
    }

    match /guidelines/{guidelineId} {
      allow read: if true; // Read operational procedures
      allow write: if true; // Manage division procedural records
    }

    match /metadata/bookmarks {
      allow read, write: if true; // Shared bookmarks coordination
    }
  }
}
