{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Category schema for procedure guidelines",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique slug identifier for category"
        },
        "name": {
          "type": "string",
          "description": "Full name of the category"
        },
        "description": {
          "type": "string",
          "description": "Detailed guidelines category description"
        },
        "iconName": {
          "type": "string",
          "description": "The lucide-react icon name"
        },
        "colorClass": {
          "type": "string",
          "description": "Tailwind badge CSS styling template"
        }
      },
      "required": ["id", "name", "description"]
    },
    "Guideline": {
      "title": "Guideline",
      "description": "Comprehensive operational checklist profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id for guideline file"
        },
        "title": {
          "type": "string",
          "description": "The checklist title"
        },
        "description": {
          "type": "string",
          "description": "Summary of purpose"
        },
        "category": {
          "type": "string",
          "description": "Assigned category key relation"
        },
        "steps": {
          "type": "array",
          "description": "Dynamic sequentially indexable steps"
        }
      },
      "required": ["id", "title", "description", "category", "steps"]
    },
    "Bookmarks": {
      "title": "Bookmarks",
      "description": "Global favorites list of guidelines",
      "type": "object",
      "properties": {
        "bookmarkedIds": {
          "type": "array",
          "description": "List of guidelines bookmarked by users"
        }
      },
      "required": ["bookmarkedIds"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Guidelines structural classifications"
    },
    "/guidelines/{guidelineId}": {
      "schema": "Guideline",
      "description": "Active procedures division checklists"
    },
    "/metadata/bookmarks": {
      "schema": "Bookmarks",
      "description": "Global user favorites registries data"
    }
  }
}
